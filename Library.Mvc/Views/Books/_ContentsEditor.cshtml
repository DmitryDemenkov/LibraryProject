@model string

<div class="contents-editor">

    <table class="table table-bordered table-hover"
           id="contents-table">

        <thead>
            <tr>
                <th style="width: 60px;">№</th>
                <th>Название</th>
                <th style="width: 150px;">Страница</th>
                <th style="width: 100px;"></th>
            </tr>
        </thead>

        <tbody id="chapters-container">
        </tbody>

    </table>

    <button type="button"
            id="add-chapter"
            class="btn btn-primary">
        + Добавить главу
    </button>

    <input type="hidden"
           id="contentsXml"
           name="Contents" />

    <textarea id="initialContentsXml"
              style="display: none;">@Html.Raw(
                  System.Web.HttpUtility.HtmlEncode(Model ?? "")
              )</textarea>

</div>