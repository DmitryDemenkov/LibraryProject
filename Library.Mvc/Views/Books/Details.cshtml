@model Library.Core.Models.Book
    
@{ 
    ViewBag.Title = "Карточка книги"; 
} 
    
<h2>Карточка книги</h2> 

<div> 
    <dl class="dl-horizontal"> 
        <dt>Название</dt> 
        <dd>@Model.Title</dd>
        
        <dt>Автор</dt> 
        <dd>@Model.Author</dd> 
        
        <dt>Год издания</dt> 
        <dd>@Model.PublishYear</dd> 
        
        <dt>ISBN</dt> 
        <dd>@Model.ISBN</dd> 
        
        <dt>Жанр</dt> 
        <dd>@Model.Genre</dd> 
    
        <dt>Описание</dt> 
        <dd>@Model.Description</dd> 
    </dl> 
</div> 

<div class="form-group">

    <label>Оглавление</label>
    @Html.Partial("_Contents", (IEnumerable<Library.Core.Models.Chapter>)ViewBag.Contents)

</div>

<p>
    @Html.ActionLink("Редактировать", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })

    @Html.ActionLink("Назад к списку", "Index", null, new { @class = "btn btn-default" })
</p>
